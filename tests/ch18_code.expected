true ? 1 : 2
== code ==
0000    1 OP_TRUE
0001    | OP_JUMP_IF_FALSE    1 -> 10
0004    | OP_POP
0005    | OP_CONSTANT         0 '1'
0007    | OP_JUMP             7 -> 13
0010    | OP_POP
0011    | OP_CONSTANT         1 '2'
0013    | OP_RETURN
1

